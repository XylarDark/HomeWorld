{
  "//": "Copy to .cursor/mcp.json and edit. That path is gitignored (live config may hold machine paths).",
  "//1": "Never write a secret literally in this file. Prefer ${env:NAME} for credentials.",
  "//2": "After changing mcp.json, fully quit and relaunch Cursor (or toggle the server in Settings -> Tools & MCP).",
  "//3": "Mixar is the default 3D tool (developer decision 2026-10-05). It is a Blender 4.2.2 fork from mixar.app, so bpy and the FBX/GLTF exporters work unchanged. Identify it by binary_path (C:\\Program Files\\Mixar\\mixar.exe) or `mixar.exe --version`; bpy.app.version returns a spoofed (5, 2, 0) and will mislead you.",
  "//4": "Use the OFFICIAL Blender Lab MCP package + add-on. Do NOT use `uvx blender-mcp` from PyPI (ahujasid) - it speaks a different protocol and the client sticks on Connecting.",
  "//5": "Install the Lab MCP client once: uv tool install \"git+https://projects.blender.org/lab/blender_mcp.git#subdirectory=mcp\"",
  "//6": "Start the server with .\\Tools\\Start-MixarMcp.ps1 (headless, blocks until localhost:9876 is reachable). Do NOT use the blender_*.cmd files shipped in the Mixar install; they are broken stock Blender launchers.",
  "//7": "Do NOT use a bare `blender` command: it silently runs vanilla Blender 4.4. Use the mixar-mcp.cmd wrapper, which pins BLENDER_PATH.",
  "//8": "unrealEditorUi is Epic's Slate inspector at http://127.0.0.1:8000/mcp. It starts with the editor. unrealMCP on 55557 stays the Python and actor server.",
  "//9": "rider is Rider's own built-in MCP server, reached over HTTP at http://127.0.0.1:64342/stream (streamable) or /sse (legacy SSE). Do NOT use @jetbrains/mcp-proxy - it probes /api/mcp/list_tools, which no Rider 2026.2 install contains. Start it with .\\Tools\\Start-RiderMcp.ps1 (headless, blocks until the port answers). File-edit and shell tools stay off; symbols, usages, UHT and refactoring stay on. unrealMCP on 55557 stays the level server.",
  "//10": "unreal-engine-skills is the public read-only skills server. No API key. Use rules are in Docs/tools/GAME_TOOL_CATALOG.md. Do not add it to opencode.json.",

  "mcpServers": {
    "unrealMCP": {
      "command": "uv",
      "args": [
        "--directory",
        "C:\\tools\\unreal-mcp\\Python",
        "run",
        "unreal_mcp_server.py"
      ]
    },
    "mixar": {
      "command": "cmd",
      "args": ["/c", "C:\\dev\\HomeWorld\\Tools\\mixar-mcp.cmd"]
    },
    "unrealEditorUi": {
      "url": "http://127.0.0.1:8000/mcp"
    },
    "rider": {
      "url": "http://127.0.0.1:64342/stream"
    },
    "unreal-engine-skills": {
      "url": "https://www.unrealengineskills.com/api/mcp"
    }
  }
}