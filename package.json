{
  "name": "homeworld",
  "version": "0.0.1",
  "private": true,
  "description": "HomeWorld Unreal project - root scripts for UserHarness doctor and layer sync",
  "scripts": {
    "doctor": "node UserHarness/dist/scripts/doctor/cli.js --project-root . ; node scripts/preflight-scorer.js",
    "doctor:ue": "node scripts/doctor-ue.js",
    "preflight:ue": "node scripts/preflight-ue.js",
    "preflight:ue:test": "node --test scripts/preflight-ue.test.js",
    "doctor:fix": "node UserHarness/dist/scripts/doctor/cli.js --project-root . --fix",
    "doctor:fast": "node UserHarness/dist/scripts/doctor/cli.js --project-root . --fast",
    "doctor:build": "cd UserHarness && npm install && npm run build",
    "sync": "node UserHarness/dist/scripts/sync/cli.js --layer agent-context,operational-memory --template ./UserHarness --project-root .",
    "sync:apply": "node UserHarness/dist/scripts/sync/cli.js --layer agent-context,operational-memory --template ./UserHarness --project-root . --apply",
    "sync:all": "node UserHarness/dist/scripts/sync/cli.js --layer all --template ./UserHarness --project-root .",
    "check:uasset-allowlist": "node scripts/check-uasset-allowlist.js",
    "t0:evidence": "node scripts/t0-evidence.js",
    "t0:evidence:test": "node --test scripts/t0-evidence.test.js",
    "t0:evidence:write": "node scripts/t0-evidence.js > Docs/qa/T0_BEAT_EVIDENCE.md",
    "tasklift": "node scripts/task-lift.js --run",
    "tasklift:dry": "node scripts/task-lift.js --dry",
    "tasklift:control": "node scripts/task-lift-control.js",
    "tasklift:control:taste": "node scripts/task-lift-control.js --manifest scripts/task-lift/tasks-taste.json",
    "tasklift:run:taste": "node scripts/task-lift.js --run --manifest scripts/task-lift/tasks-taste.json --out-md Docs/qa/TASK_LIFT_TASTE.md --out-json Docs/qa/TASK_LIFT_TASTE.json",
    "tasklift:test": "node --test scripts/task-lift.test.js",
    "tasklift:write": "node scripts/task-lift.js --run --out-md Docs/qa/TASK_LIFT.md --out-json Docs/qa/TASK_LIFT.json",
    "decisions:test": "node --test scripts/decision-log.test.js",
    "scope:reconcile": "node scripts/scope-reconcile.js",
    "scope:reconcile:write": "node scripts/scope-reconcile.js --write Docs/qa/T0_SCOPE_RECONCILIATION.md",
    "scope:reconcile:test": "node --test scripts/scope-reconcile.test.js",
    "test:all": "node --test \"scripts/*.test.js\"",
    "outcome:test": "node --test scripts/outcome.test.js",
    "decisions": "node scripts/decision-log.js",
    "verify": "node scripts/verify.js",
    "verify:fast": "node scripts/verify.js --tier fast",
    "verify:ue": "node scripts/verify.js --tier ue",
    "editor:lock": "node scripts/editor-lock.js"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
