{
  "name": "homeworld",
  "version": "0.0.1",
  "private": true,
  "description": "HomeWorld Unreal project - root scripts for DevEnvTemplate doctor and layer sync",
  "scripts": {
    "doctor": "node DevEnvTemplate/dist/scripts/doctor/cli.js --project-root .",
    "doctor:fix": "node DevEnvTemplate/dist/scripts/doctor/cli.js --project-root . --fix",
    "doctor:fast": "node DevEnvTemplate/dist/scripts/doctor/cli.js --project-root . --fast",
    "doctor:build": "cd DevEnvTemplate && npm install && npm run build",
    "sync": "node DevEnvTemplate/dist/scripts/sync/cli.js --layer agent-context,operational-memory --template ./DevEnvTemplate --project-root .",
    "sync:apply": "node DevEnvTemplate/dist/scripts/sync/cli.js --layer agent-context,operational-memory --template ./DevEnvTemplate --project-root . --apply",
    "sync:all": "node DevEnvTemplate/dist/scripts/sync/cli.js --layer all --template ./DevEnvTemplate --project-root ."
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
